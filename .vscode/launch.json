{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 Next.js: Web Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @cardflow-app/web dev",
      "cwd": "${workspaceFolder}/cardflow-app"
    },
    {
      "name": "⚙️ Go: Cardflow Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cardflow-backend/cmd/server/main.go",
      "cwd": "${workspaceFolder}/cardflow-backend"
    }
  ]
}

{
  "app": {
    "env": "local",
    "log_level": "debug",
    "log_color": true
  },
  "api": {
    "http_addr": ":8080",
    "grpc_addr": ":9090",
    "timeout": "30s",
    "idle_timeout": "60s",
    "grpc_max_concurrent_streams": 100,
    "grpc_reflection_enabled": true,
    "swagger": {
      "enabled": false,
      "base_path": "/",
      "title": "cardflow-backend API"
    }
  },
  "gateway": {
    "_comment": "Service dung sau Kong (brm-authz). `tokens` PHAI co mat (du la []) thi GATEWAY_TOKENS moi bind duoc — thieu key nay env bi bo qua LANG LE. Gia tri that khai qua env, khong viet vao day.",
    "tokens": [],
    "token_header": "X-Gateway-Token",
    "user_header": "X-User-Id",
    "tenant_header": "X-Tenant-Id"
  },
  "tracing": {
    "enabled": true,
    "otlp_endpoint": "",
    "sample_ratio": 1.0
  },
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "database": "sample_db",
    "user": "postgres",
    "password": "password",
    "max_open_conns": 10,
    "max_idle_conns": 5,
    "conn_max_lifetime": "5m",
    "ssl_mode": "disable",
    "connect_timeout": "10s"
  },
  "redis": {
    "addrs": [
      "localhost:6379"
    ],
    "password": "",
    "db": 0,
    "pool_size": 10,
    "dial_timeout": "5s",
    "read_timeout": "3s",
    "write_timeout": "3s"
  },
  "grpc_clients": {},
  "http_clients": {}
}

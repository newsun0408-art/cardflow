# Key map tá»« config: postgres.host â†’ POSTGRES_HOST, app.log_level â†’ APP_LOG_LEVEL...
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:8080/cardflow-backend/v1/drive/actions/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/spreadsheets

# Token xac nhan request da di qua Kong (middleware/gateway). Danh sach ngan cach
# bang dau phay de xoay secret hai pha: nhan ca cu lan moi -> doi Kong -> bo cu.
# Thieu bien nay thi service TU CHOI KHOI DONG â€” co y: cong khong dung duoc thi
# phai chet luc boot, khong phai cho traffic di qua trong khi pod nhin van khoe.
# Xin token tu doi Platform.
GATEWAY_TOKENS=doi-token-that-truoc-khi-chay
